# ==============================================================================
# CampusBites Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate the actual credentials.

# Server Port (Render sets this dynamically via PORT env variable)
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret for Staff Authentication Tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Legacy fallback staff password
STAFF_PASSWORD=admin123

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Option 1: Direct Connection URI (Recommended for Cloud / Supabase / Render Postgres)
# Note: Ensure special characters in passwords (like @, [, ]) are URL-encoded.
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Option 2: Individual Connection Parameters (For local development fallback)
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=campusbites
PGPORT=5432

# ==============================================================================
# Redis Configuration (BullMQ & Caching)
# ==============================================================================
# Option 1: Direct Redis URL (Supports Upstash TLS `rediss://` or local `redis://`)
REDIS_URL=rediss://default:your_redis_token@your-redis-host.upstash.io:6379

# Option 2: Individual Redis Parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# Sentry Observability (Optional)
# ==============================================================================
SENTRY_DSN=
